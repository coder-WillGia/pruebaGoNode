      "name": "1. Flujo Principal (Go API :3000)",
      "item": [
        {
          "name": "Procesar Matriz 3x3 (Factorización QR + Estadísticas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matrix\": [\n    [12, -51, 4],\n    [6, 167, -68],\n    [-4, 24, -41]\n  ]\n}"
            },
            "url": {
              "raw": "{{go_url}}/api/v1/matrix/process",
              "host": ["{{go_url}}"],
              "path": ["api", "v1", "matrix", "process"]
            },
            "description": "Calcula Factorización QR en Go, envía Q y R a Node.js para obtener Max, Min, Promedio, Suma y estado de Matriz Diagonal, y guarda la operación en BD."
          }
        },
        {
          "name": "Procesar Matriz Rectangular 4x2",
